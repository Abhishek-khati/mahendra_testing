{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker/Dockerfile",
    "watchPatterns": [
      "worker/**",
      "server/analysis/worker-entry.ts",
      "server/analysis/contracts.ts",
      "server/analysis/evidence.ts"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node worker-server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
