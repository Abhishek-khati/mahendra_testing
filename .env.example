# ChainShield AI — Environment Variables
# Copy this to .env and fill in the values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://chainshield:yourpassword@localhost:3306/chainshield
MYSQL_PASSWORD=yourpassword
MYSQL_ROOT_PASSWORD=yourrootpassword

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-64-char-secret

# ── OAuth (Google) ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Analysis Worker ───────────────────────────────────────────────────────────
# WORKER_SECRET_TOKEN: shared secret between main app and worker service
# Generate with: openssl rand -base64 32
WORKER_SECRET_TOKEN=replace-with-a-random-secret

# CHAINSHIELD_WORKER_URL:
#   - Docker Compose (local): http://worker:4000  (auto-set via compose)
#   - Railway/Cloud:          https://your-worker.up.railway.app
CHAINSHIELD_WORKER_URL=http://localhost:4000

# CHAINSHIELD_WORKER_TOKEN: same as WORKER_SECRET_TOKEN
CHAINSHIELD_WORKER_TOKEN=replace-with-a-random-secret

# ── AI (for finding explanations) ────────────────────────────────────────────
FORGE_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for rate limiting (apiRateLimit)
REDIS_URL=redis://localhost:6379

# ── On-Chain Report Anchoring (Ethereum Sepolia) ──────────────────────────────
# Deploy contracts/ChainShieldAnchor.sol to Sepolia, then fill in below.
# ANCHOR_PRIVATE_KEY: hot wallet signing key — testnet ONLY, never use mainnet wallet!
#   Fund with free Sepolia ETH from: https://sepoliafaucet.com
# ANCHOR_RPC_URL: Sepolia RPC — Alchemy, Infura, or public https://rpc.sepolia.org
# ANCHOR_CONTRACT_ADDRESS: deployed ChainShieldAnchor contract address on Sepolia
ANCHOR_PRIVATE_KEY=0x_testnet_only_private_key_here
ANCHOR_RPC_URL=https://rpc.sepolia.org
ANCHOR_CONTRACT_ADDRESS=0x_deploy_ChainShieldAnchor_sol_to_get_this

# ── Centralized Monitoring (Sentry & Prometheus) ───────────────────────────────
# Backend Sentry DSN for server-side error capturing
SENTRY_DSN=
# Frontend Sentry DSN for client-side crash reporting
VITE_SENTRY_DSN=
# Prometheus metrics are exposed at GET /metrics on the main server port (e.g. http://localhost:3000/metrics)

